{
    "manifest_version": 3,
    "name": "NovExtractor",
    "version": "0.2.3",
    "description": "Export the web novel chapter you're reading to Markdown, EPUB or PDF. Works only on sites you add yourself.",
    "permissions": ["storage", "scripting"],
    "optional_host_permissions": ["http://*/*", "https://*/*"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "NovExtractor settings"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    }
}
